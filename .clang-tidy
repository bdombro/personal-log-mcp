# Pending lint follow-ups (enable one check per reviewed commit):
#   -bugprone-unchecked-string-to-number-conversion (2 findings)
#   -bugprone-optional-value-conversion (1 finding)
#   -bugprone-narrowing-conversions (1 finding)
#   -bugprone-exception-escape (1 finding)
#   -bugprone-command-processor (1 finding)
Checks: '-*,clang-analyzer-core.*,clang-analyzer-cplusplus.*,bugprone-*,-bugprone-easily-swappable-parameters,-bugprone-signed-bitwise,-bugprone-throwing-static-initialization,-bugprone-reserved-identifier,-bugprone-branch-clone,-bugprone-macro-parentheses,-bugprone-lambda-function-name,-bugprone-std-exception-baseclass,-bugprone-switch-missing-default-case,-bugprone-argument-comment,-bugprone-unintended-char-ostream-output,-bugprone-unchecked-string-to-number-conversion,-bugprone-optional-value-conversion,-bugprone-narrowing-conversions,-bugprone-exception-escape,-bugprone-command-processor'
WarningsAsErrors: '*'
HeaderFilterRegex: '[/\\](src|tests)[/\\]'
SystemHeaders: false
